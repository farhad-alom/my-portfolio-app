# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# These three keys are PUBLIC browser keys — they are safe to ship to the
# client. Never put private keys, API secrets, or database passwords here.
#
# Find them at https://dashboard.emailjs.com/ :
#   Service ID  -> Email Services
#   Template ID -> Email Templates
#   Public Key  -> Account > General
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional: your deployed site URL (used for absolute Open Graph links).
NEXT_PUBLIC_SITE_URL=
